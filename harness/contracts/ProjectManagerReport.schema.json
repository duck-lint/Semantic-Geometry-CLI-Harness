{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DriftDetection": {
      "additionalProperties": false,
      "properties": {
        "drift_detected": {
          "title": "Drift Detected",
          "type": "boolean"
        },
        "description": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Description"
        }
      },
      "required": [
        "drift_detected",
        "description"
      ],
      "title": "DriftDetection",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "const": "project_manager_report.json",
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "const": "Project Manager Report",
          "title": "Title",
          "type": "string"
        },
        "source_format": {
          "const": "json",
          "title": "Source Format",
          "type": "string"
        },
        "document_authority": {
          "const": "output_policy_artifact",
          "title": "Document Authority",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "source_format",
        "document_authority"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ProofFrontier": {
      "additionalProperties": false,
      "properties": {
        "constraint_conflicts": {
          "items": {
            "type": "string"
          },
          "title": "Constraint Conflicts",
          "type": "array"
        },
        "dominant_tension_justification": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Dominant Tension Justification"
        },
        "blocked": {
          "title": "Blocked",
          "type": "boolean"
        },
        "blocking_reason": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Blocking Reason"
        },
        "missing_basis": {
          "items": {
            "type": "string"
          },
          "title": "Missing Basis",
          "type": "array"
        },
        "next_admissible_transformation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Next Admissible Transformation"
        },
        "affected_surfaces": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Affected Surfaces"
        },
        "non_affected_surfaces": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Non Affected Surfaces"
        },
        "stop_conditions": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Stop Conditions"
        },
        "authority_constraints": {
          "items": {
            "type": "string"
          },
          "title": "Authority Constraints",
          "type": "array"
        }
      },
      "required": [
        "constraint_conflicts",
        "dominant_tension_justification",
        "blocked",
        "blocking_reason",
        "missing_basis",
        "next_admissible_transformation",
        "affected_surfaces",
        "non_affected_surfaces",
        "stop_conditions",
        "authority_constraints"
      ],
      "title": "ProofFrontier",
      "type": "object"
    },
    "ReportSourceCoverage": {
      "additionalProperties": false,
      "properties": {
        "static_context_packet": {
          "$ref": "#/$defs/ReportSourceCoverageEntry"
        },
        "task": {
          "$ref": "#/$defs/ReportSourceCoverageEntry"
        },
        "repo_snapshot_packet": {
          "$ref": "#/$defs/ReportSourceCoverageEntry"
        },
        "git_context": {
          "$ref": "#/$defs/ReportSourceCoverageEntry"
        }
      },
      "required": [
        "static_context_packet",
        "task",
        "repo_snapshot_packet",
        "git_context"
      ],
      "title": "ReportSourceCoverage",
      "type": "object"
    },
    "ReportSourceCoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "consumed": {
          "description": "Whether the Project Manager materially reviewed the source. This does not indicate that the source is binding authority.",
          "title": "Consumed",
          "type": "boolean"
        },
        "disposition": {
          "description": "How the Project Manager handled this source in this report. 'used' means the source materially supported a report claim, not that it is binding authority. 'inspected_insufficient' means the source was reviewed but did not substantiate the requested claim family. 'inspected_not_relevant' means it was reviewed but was outside the task. 'inspected_contradictory' means it contradicted the requested claim family without independently determining report_status. 'missing' and 'invalid' describe source availability or validity, not authority. 'not_required_for_task' means the source was unnecessary for the current task.",
          "enum": [
            "used",
            "inspected_insufficient",
            "inspected_not_relevant",
            "inspected_contradictory",
            "missing",
            "invalid",
            "not_required_for_task"
          ],
          "title": "Disposition",
          "type": "string"
        },
        "basis": {
          "description": "Concrete free-text explanation of the disposition. It may name a governance evidence_class or valid_claim_family when useful, but the text is descriptive and is not parsed for validation.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Basis",
          "type": "array"
        }
      },
      "required": [
        "consumed",
        "disposition",
        "basis"
      ],
      "title": "ReportSourceCoverageEntry",
      "type": "object"
    },
    "TrajectoryReview": {
      "additionalProperties": false,
      "properties": {
        "current_posture": {
          "title": "Current Posture",
          "type": "string"
        },
        "thesis_attractor": {
          "title": "Thesis Attractor",
          "type": "string"
        },
        "drift_detection": {
          "$ref": "#/$defs/DriftDetection"
        },
        "structural_tension": {
          "title": "Structural Tension",
          "type": "string"
        }
      },
      "required": [
        "current_posture",
        "thesis_attractor",
        "drift_detection",
        "structural_tension"
      ],
      "title": "TrajectoryReview",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "report_status": {
      "enum": [
        "admissible",
        "admissibility_blocked",
        "rejected",
        "needs_clarification"
      ],
      "title": "Report Status",
      "type": "string"
    },
    "report_summary": {
      "title": "Report Summary",
      "type": "string"
    },
    "report_source_coverage": {
      "$ref": "#/$defs/ReportSourceCoverage"
    },
    "trajectory_review": {
      "$ref": "#/$defs/TrajectoryReview"
    },
    "proof_frontier": {
      "$ref": "#/$defs/ProofFrontier"
    }
  },
  "required": [
    "metadata",
    "report_status",
    "report_summary",
    "report_source_coverage",
    "trajectory_review",
    "proof_frontier"
  ],
  "title": "ProjectManagerReport",
  "type": "object"
}