{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "MissingSourceEntry": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "document_authority": {
          "enum": [
            "harness_target",
            "compiled_runtime_artifact",
            "operational_state",
            "global_harness",
            "output_policy_artifact",
            "raw_provider_artifact"
          ],
          "title": "Document Authority",
          "type": "string"
        },
        "effect": {
          "enum": [
            "blocks_compilation",
            "recorded_absent"
          ],
          "title": "Effect",
          "type": "string"
        }
      },
      "required": [
        "source_id",
        "schema_id",
        "document_authority",
        "effect"
      ],
      "title": "MissingSourceEntry",
      "type": "object"
    },
    "SourceCoverageEntry": {
      "additionalProperties": false,
      "properties": {
        "source_id": {
          "title": "Source Id",
          "type": "string"
        },
        "layer": {
          "const": "static_context",
          "title": "Layer",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        },
        "schema_id": {
          "title": "Schema Id",
          "type": "string"
        },
        "document_authority": {
          "enum": [
            "harness_target",
            "compiled_runtime_artifact",
            "operational_state",
            "global_harness",
            "output_policy_artifact",
            "raw_provider_artifact"
          ],
          "title": "Document Authority",
          "type": "string"
        },
        "status": {
          "enum": [
            "included",
            "missing",
            "invalid"
          ],
          "title": "Status",
          "type": "string"
        },
        "resolved_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Resolved Path"
        },
        "validation": {
          "$ref": "#/$defs/SourceValidation"
        },
        "basis": {
          "items": {
            "type": "string"
          },
          "title": "Basis",
          "type": "array"
        }
      },
      "required": [
        "source_id",
        "layer",
        "required",
        "schema_id",
        "document_authority",
        "status",
        "validation"
      ],
      "title": "SourceCoverageEntry",
      "type": "object"
    },
    "SourceValidation": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "passed",
            "failed",
            "not_run"
          ],
          "title": "Status",
          "type": "string"
        },
        "validator": {
          "const": "json_parse",
          "title": "Validator",
          "type": "string"
        },
        "parsed_content_available": {
          "title": "Parsed Content Available",
          "type": "boolean"
        },
        "failure": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Failure"
        }
      },
      "required": [
        "status",
        "validator",
        "parsed_content_available"
      ],
      "title": "SourceValidation",
      "type": "object"
    },
    "StaticContextPacketMetadata": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "const": "static_context_packet.json",
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "const": "Static Context Packet",
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "const": "Compiled static authority and operational context from StaticContextPacketManifest.",
          "title": "Purpose",
          "type": "string"
        },
        "source_format": {
          "const": "json",
          "title": "Source Format",
          "type": "string"
        },
        "document_authority": {
          "const": "compiled_runtime_artifact",
          "title": "Document Authority",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "purpose",
        "source_format",
        "document_authority"
      ],
      "title": "StaticContextPacketMetadata",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "metadata": {
      "$ref": "#/$defs/StaticContextPacketMetadata"
    },
    "sources": {
      "additionalProperties": true,
      "title": "Sources",
      "type": "object"
    },
    "source_coverage": {
      "items": {
        "$ref": "#/$defs/SourceCoverageEntry"
      },
      "title": "Source Coverage",
      "type": "array"
    },
    "missing_sources": {
      "items": {
        "$ref": "#/$defs/MissingSourceEntry"
      },
      "title": "Missing Sources",
      "type": "array"
    }
  },
  "required": [
    "metadata",
    "sources",
    "source_coverage"
  ],
  "title": "StaticContextPacket",
  "type": "object"
}