{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "DocumentAuthorityClasses": {
      "additionalProperties": false,
      "properties": {
        "binding_authority": {
          "items": {
            "enum": [
              "global_harness",
              "harness_target",
              "runtime_policy",
              "operational_state"
            ],
            "type": "string"
          },
          "title": "Binding Authority",
          "type": "array"
        },
        "derived_runtime_artifacts": {
          "items": {
            "enum": [
              "compiled_runtime_artifact",
              "output_policy_artifact",
              "raw_provider_artifact",
              "validation_artifact",
              "ledger_artifact",
              "archive_record"
            ],
            "type": "string"
          },
          "title": "Derived Runtime Artifacts",
          "type": "array"
        }
      },
      "required": [
        "binding_authority",
        "derived_runtime_artifacts"
      ],
      "title": "DocumentAuthorityClasses",
      "type": "object"
    },
    "EvidenceClasses": {
      "additionalProperties": false,
      "properties": {
        "runtime_evidence": {
          "items": {
            "enum": [
              "compiled_runtime_artifact",
              "output_policy_artifact",
              "raw_provider_artifact",
              "validation_artifact",
              "ledger_artifact",
              "archive_record"
            ],
            "type": "string"
          },
          "title": "Runtime Evidence",
          "type": "array"
        },
        "valid_claim_families": {
          "$ref": "#/$defs/ValidClaimFamilies"
        },
        "boundary_rule": {
          "const": "Evidence classes may substantiate bounded runtime, validation, provenance, or historical claims. They do not create project authority, amend project intent, authorize route changes, or override binding authority.",
          "title": "Boundary Rule",
          "type": "string"
        }
      },
      "required": [
        "runtime_evidence",
        "valid_claim_families",
        "boundary_rule"
      ],
      "title": "EvidenceClasses",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "document_id": {
          "const": "governance_primitives.json",
          "title": "Document Id",
          "type": "string"
        },
        "title": {
          "const": "Governance Primitives",
          "title": "Title",
          "type": "string"
        },
        "context": {
          "const": "Global governance for the CLI harness. These primitives govern agent operation, execution boundaries, runtime artifact semantics, and authority separation in every target repository the harness is placed inside and invoked against.",
          "title": "Context",
          "type": "string"
        },
        "purpose": {
          "const": "Define and delineate global harness-level invariants from harness target repository boundaries that every project workflow must respect.",
          "title": "Purpose",
          "type": "string"
        },
        "source_format": {
          "const": "json",
          "title": "Source Format",
          "type": "string"
        },
        "document_authority": {
          "const": "global_harness",
          "title": "Document Authority",
          "type": "string"
        }
      },
      "required": [
        "document_id",
        "title",
        "context",
        "purpose",
        "source_format",
        "document_authority"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "ValidClaimFamilies": {
      "additionalProperties": false,
      "properties": {
        "compiled_runtime_artifact": {
          "items": {
            "enum": [
              "context_was_compiled",
              "payload_was_constructed"
            ],
            "type": "string"
          },
          "title": "Compiled Runtime Artifact",
          "type": "array"
        },
        "output_policy_artifact": {
          "items": {
            "enum": [
              "agent_output_was_parsed",
              "agent_output_matched_schema",
              "bounded_report_claim_was_emitted"
            ],
            "type": "string"
          },
          "title": "Output Policy Artifact",
          "type": "array"
        },
        "raw_provider_artifact": {
          "items": {
            "enum": [
              "provider_returned_response",
              "audit_trace_exists"
            ],
            "type": "string"
          },
          "title": "Raw Provider Artifact",
          "type": "array"
        },
        "validation_artifact": {
          "items": {
            "enum": [
              "schema_validation_passed_or_failed",
              "probe_result_recorded"
            ],
            "type": "string"
          },
          "title": "Validation Artifact",
          "type": "array"
        },
        "ledger_artifact": {
          "items": {
            "enum": [
              "api_call_was_recorded",
              "route_invocation_was_recorded",
              "token_usage_was_recorded"
            ],
            "type": "string"
          },
          "title": "Ledger Artifact",
          "type": "array"
        },
        "archive_record": {
          "items": {
            "enum": [
              "bounded_historical_claim_was_preserved",
              "future_reports_may_cite_record_without_reconstructing_raw_artifacts"
            ],
            "type": "string"
          },
          "title": "Archive Record",
          "type": "array"
        }
      },
      "required": [
        "compiled_runtime_artifact",
        "output_policy_artifact",
        "raw_provider_artifact",
        "validation_artifact",
        "ledger_artifact",
        "archive_record"
      ],
      "title": "ValidClaimFamilies",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "title": "$Schema",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "document_authority_classes": {
      "$ref": "#/$defs/DocumentAuthorityClasses"
    },
    "agent_contracts": {
      "items": {
        "enum": [
          "project_manager",
          "planning_manager",
          "review_manager",
          "red_team_manager",
          "implementation_manager",
          "archive_manager",
          "worker_adapter"
        ],
        "type": "string"
      },
      "title": "Agent Contracts",
      "type": "array"
    },
    "approval_sensitive_surfaces": {
      "default": [],
      "items": {
        "enum": [
          "global_harness",
          "agent_contracts",
          "output_policies",
          "runtime_orchestration",
          "tool_and_worker_surface",
          "provider_or_api_behavior",
          "compatibility_commitments"
        ],
        "type": "string"
      },
      "title": "Approval Sensitive Surfaces",
      "type": "array"
    },
    "evidence_classes": {
      "$ref": "#/$defs/EvidenceClasses"
    }
  },
  "required": [
    "$schema",
    "metadata",
    "document_authority_classes",
    "agent_contracts",
    "evidence_classes"
  ],
  "title": "GovernancePrimitives",
  "type": "object"
}